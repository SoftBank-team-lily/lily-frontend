DATABASE_URL=postgresql://lily:lily-local@localhost:5438/lily
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_TRUSTED_ORIGINS=http://localhost:3000
SMTP_URL=smtp://localhost:1026
MAIL_FROM=Lily <noreply@lily.local>
# 배포 실행기가 상태를 전달할 때 사용하는 서버 전용 키.
DEPLOYMENT_API_KEY=replace-with-another-random-secret-at-least-32-characters
# 실제 대시보드가 생긴 뒤 URL을 설정합니다.
DASHBOARD_URL=
# 등록한 프로젝트를 실제로 배포하는 실행기 (src/lib/builder). 비우면 꺼진다
BUILDER_URL=
# auto: 레포의 DB 드라이버로 postgres / mysql / 없음을 정한다
BUILDER_DATABASE=auto
# 이 GitHub 소유자의 레포만 배포한다 (쉼표 구분). 비우면 모두
BUILDER_ALLOWED_OWNERS=

# 대시보드 서버 원점. 같은 공개 도메인의 /dashboard 로 프록시한다 (basePath 필요)
DASHBOARD_ORIGIN=
# 서버 전용 내부 서비스 URL. 토큰에 NEXT_PUBLIC_ 접두사를 붙이지 않는다
OBSERVABILITY_URL=
OBSERVABILITY_API_TOKEN=
DEPLOYMENT_NAMESPACE=default
INGRESS_API_URL=
INGRESS_API_TOKEN=
PROVISIONER_URL=
PROVISIONER_API_TOKEN=

# builder의 CLOUD_API_TOKEN과 동일한 내부 자동 선택 API 토큰 (32자 이상)
CLOUD_API_TOKEN=
